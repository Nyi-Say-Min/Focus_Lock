{
  "manifest_version": 3,
  "name": "FocusLock Browser Companion",
  "version": "0.2.0",
  "minimum_chrome_version": "120",
  "key": "",
  "permissions": ["tabs", "storage", "alarms", "declarativeNetRequest"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "background": { "service_worker": "background.js" },
  "action": { "default_title": "FocusLock", "default_popup": "page.html" },
  "options_page": "page.html",
  "web_accessible_resources": [
    { "resources": ["page.html", "page.js", "theme.css"], "matches": ["http://*/*", "https://*/*"] }
  ]
}
